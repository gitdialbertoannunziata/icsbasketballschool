{
  "name": "icsbasketballschool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm --prefix api test",
    "api:build": "npm --prefix api run build",
    "azurite": "azurite-blob --silent --location .azurite --blobHost 0.0.0.0 --blobPort 10000 --loose --skipApiVersionCheck",
    "storage:setup": "tsx scripts/setup-storage.ts",
    "seed": "tsx scripts/seed.ts",
    "import": "tsx scripts/import-wp.ts",
    "swa": "swa start",
    "start": "concurrently -k -n azurite,swa \"npm:azurite\" \"npm run api:build && swa start\"",
    "import:check": "tsx scripts/validate-output.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "dompurify": "^3.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "yet-another-react-lightbox": "^3.21.0"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "^2.0.0",
    "@azure/storage-blob": "^12.26.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "azurite": "^3.33.0",
    "cheerio": "^1.0.0",
    "concurrently": "^9.1.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
